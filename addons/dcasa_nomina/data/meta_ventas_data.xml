<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Bono por meta de ventas (models/meta_ventas.py): Tommalo todavía no decide su meta ni su bono (PENDIENTE), así
         que no viene ninguna regla de fábrica. Gerencia la crea en Nómina › Configuración › Meta de ventas (una meta
         que rija desde un mes). Sin regla no se calcula ningún bono. -->

    <!-- Participa quien está en el departamento «Ventas»: se marca solo una vez; después lo decide Gerencia. -->
    <function model="hr.department" name="_dcasa_marcar_ventas"/>

    <record id="cron_meta_ventas" model="ir.cron">
        <field name="name">Nómina: poner al día el bono por meta de ventas</field>
        <field name="model_id" ref="model_dcasa_nomina_meta_bono"/>
        <field name="state">code</field>
        <field name="code">model._cron_actualizar()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
