<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Ventana de la campaña del sitio (models/black_weekend.py): de fábrica apagada y sin fechas
         (PENDIENTE: las de la primera campaña de Tommalo, hora de Panamá, inclusive). Fuera de las fechas la campaña
         desaparece sola. «activo» = 1 la muestra sin mirar fechas (staging).
         Solo se fijan los parámetros que no existen: docker/entrypoint.sh los fija por entorno
         (DCASA_BLACK_WEEKEND*) y lo que se cambie en Ajustes > Técnico > Parámetros del sistema
         no se pisa al actualizar. -->
    <function model="website" name="_dcasa_bw_parametros_por_defecto"/>

    <!-- Campaña del sitio (models/campana.py): la tarifa del visitante, ofrecida al sitio para que la página muestre
         el mismo precio que cobra el carrito (incluido el de campaña). Idempotente: corre en cada actualización. -->
    <function model="dcasa.campana" name="_dcasa_tarifa_del_sitio"/>
</odoo>
