<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Datos de la empresa de Tommalo. Solo lo decidido: el nombre y el país. RUC, DV, dirección, ciudad, teléfono,
         correo, web y lema de los documentos: vacíos hasta que Tommalo los dé (nunca se inventan ni se copian los de
         otra empresa; docs/PENDIENTES_DEL_CLIENTE.md). El logo es un marcador provisional (una «T»): el definitivo lo
         sube Tommalo en Ajustes › Marca del panel. noupdate: una vez instalados, se editan desde Ajustes › Empresas. -->
    <data noupdate="1">
        <record id="base.main_company" model="res.company">
            <field name="name">Tommalo</field>
            <field name="country_id" ref="base.pa"/>
            <field name="logo" type="base64" file="dcasa_base/static/img/logo.png"/>
            <!-- Colores de los documentos y correos: PENDIENTE (docs/MARCA_TOMMALO.md). Provisionales y neutros. -->
            <field name="primary_color">#262626</field>
            <field name="secondary_color">#D4D4D4</field>
        </record>
    </data>
</odoo>
